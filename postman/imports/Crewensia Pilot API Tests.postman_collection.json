              "const j=pm.response.json(); const email=pm.collectionVariables.get('organizerEmail'); const item=j.data.find(x=>x.organizer.user.email===email); pm.test('New organizer verification is listed',()=>pm.expect(item).to.exist); if(item) pm.collectionVariables.set('verificationId',item.id);"
