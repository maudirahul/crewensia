    {
      "name": "Create event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Pilot Volunteer Event\",\n  \"description\": \"Temporary event created while exercising the Crewensia API.\",\n  \"venueName\": \"Test Hall\",\n  \"venueAddress\": \"1 Test Street\",\n  \"locality\": \"Test Locality\",\n  \"city\": \"Postman Test City\",\n  \"startsAt\": \"{{eventStartsAt}}\",\n  \"endsAt\": \"{{eventEndsAt}}\",\n  \"applicationDeadline\": \"{{deadline}}\",\n  \"category\": \"Community\",\n  \"eligibility\": \"Pilot API test participants.\",\n  \"benefits\": \"No real payment; test only.\",\n  \"roles\": [\n    {\n      \"title\": \"Event Helper\",\n      \"responsibilities\": \"Support event check-in.\",\n      \"requiredSkills\": [\n        \"first-aid\",\n        \"event-support\"\n      ],\n      \"compensationType\": \"UNPAID\",\n      \"shifts\": [\n        {\n          \"startsAt\": \"{{shiftOneStart}}\",\n          \"endsAt\": \"{{shiftOneEnd}}\",\n          \"openings\": 2\n        },\n        {\n          \"startsAt\": \"{{shiftTwoStart}}\",\n          \"endsAt\": \"{{shiftTwoEnd}}\",\n          \"openings\": 2\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{organizerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response is valid JSON', function () { pm.response.to.be.json; });",
              "const e=pm.response.json().data; pm.collectionVariables.set('eventId',e.id); pm.collectionVariables.set('firstShiftId',e.roles[0].shifts[0].id); pm.collectionVariables.set('secondShiftId',e.roles[0].shifts[1].id);"
            ]
          }
        }
      ]
    },
